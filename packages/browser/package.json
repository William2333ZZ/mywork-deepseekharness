{
  "name": "dsh-mywork-browser",
  "version": "0.2.0",
  "description": "真实浏览器 for DeepSeek Harness：后台拉起本机 Chrome（无头），模型经官方 browser-use + Playwright MCP 驱动；右侧栏「实时浏览器」标签实时渲染画面、可接管；地址栏书签、open_url / quick_links 工具、/open 命令；设置 → MyWork → 浏览器。GitHub 等禁止 iframe 嵌入的站点照常可用（没有 iframe）。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "browser",
    "browser-use",
    "playwright",
    "bookmarks",
    "open-url"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-client.mjs .",
    "check": "node --check src/index.js && node --check src/chrome.js && node --check src/cdp.js && node --check src/links.js && node --check src/history.js && node --check src/mcp-provider.js && node --check src/client/index.js",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.1.6-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "mywork": {
    "clientPrelude": [
      "../../scripts/client-icons.cjs"
    ]
  }
}
