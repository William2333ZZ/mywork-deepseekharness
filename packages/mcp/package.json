{
  "name": "dsh-mywork-mcp",
  "version": "0.0.1",
  "description": "MCP 服务器配置 for DeepSeek Harness Web：在侧栏「MCP 连接器」页面里添加 / 编辑 / 停用 MCP 服务器（stdio 或 streamable-http），支持导入 Claude Desktop / Cursor 风格的 mcpServers JSON；通过 dsh 的 loader 动态生成官方 @deepseek-ai/dsh-mcp-client 条目，不重启即生效。配置在 $DSH_HOME/mywork/mcp.json。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "model-context-protocol"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-client.mjs .",
    "check": "node --check src/index.js && node --check src/store.js && node --check src/client/index.js",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.6-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "mywork": {
    "clientPrelude": [
      "../../scripts/client-icons.cjs"
    ]
  }
}
