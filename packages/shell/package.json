{
  "name": "dsh-mywork-shell",
  "version": "0.1.0",
  "description": "MyWork 外观 for DeepSeek Harness Web：Claude Code / Codex 主题（覆盖 dsh 自带浅色/深色 token，明暗跟随 dsh 设置）+ 界面缩放；作为「设置 → MyWork → 外观」标签页出现。侧栏由 dsh-mywork-codex-ui 提供。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "appearance",
    "zoom",
    "claude-code",
    "codex"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-client.mjs .",
    "check": "node --check src/index.js && node --check src/client/index.js"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
